\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Window dependence of the gating comparison.} Failure rate for gate filtered (left) and gate unfiltered (right) at 2.5, 6, and 10~s windows. At 140~ms, the 2.5~s window undercounts failures; at 6 and 10~s the two gating variants converge.}}{24}{figure.3}\protected@file@percent }
\newlabel{fig:window}{{3}{24}{\textbf {Window dependence of the gating comparison.} Failure rate for gate filtered (left) and gate unfiltered (right) at 2.5, 6, and 10~s windows. At 140~ms, the 2.5~s window undercounts failures; at 6 and 10~s the two gating variants converge}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {V-term and gate-threshold stress tests.} Left, failure rate for gate filtered across clip, smooth, and unclipped V treatments. Middle and right, failure rate for gate filtered across gate thresholds from 0.01 to 0.5 of the bar-torque scale under clip and smooth V. The short-delay (20 to 50~ms) gating advantage for gate filtered survives all treatments; the 100~ms advantage does not. The second gating signal in the threshold sweep (gate unfiltered) matches these zeros except at threshold 0.5 under clip, where it fails in 25\% of runs at 50~ms and 62.5\% at 100~ms; that cell is not plotted here.}}{24}{figure.4}\protected@file@percent }
\newlabel{fig:stress}{{4}{24}{\textbf {V-term and gate-threshold stress tests.} Left, failure rate for gate filtered across clip, smooth, and unclipped V treatments. Middle and right, failure rate for gate filtered across gate thresholds from 0.01 to 0.5 of the bar-torque scale under clip and smooth V. The short-delay (20 to 50~ms) gating advantage for gate filtered survives all treatments; the 100~ms advantage does not. The second gating signal in the threshold sweep (gate unfiltered) matches these zeros except at threshold 0.5 under clip, where it fails in 25\% of runs at 50~ms and 62.5\% at 100~ms; that cell is not plotted here}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Adaptive updates.} Failure rate (left) and mean learned gain (right) for the source-style squared-error update, a signed-error gradient, and the opposite-sign control. The signed update keeps the gain lower but does not change failure.}}{25}{figure.5}\protected@file@percent }
\newlabel{fig:adaptive}{{5}{25}{\textbf {Adaptive updates.} Failure rate (left) and mean learned gain (right) for the source-style squared-error update, a signed-error gradient, and the opposite-sign control. The signed update keeps the gain lower but does not change failure}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Command copy versus filtered plant state.} Left, failure rate for graded efference copy at gain 1.0 for the filtered plant state, the pre-plant-filter command copy, and the current-visual oracle. Right, gate duty cycle for the same three signals; failure rates for the three gates were identical. The command copy overlaps the filtered plant state. Only the current-visual oracle differs.}}{25}{figure.6}\protected@file@percent }
\newlabel{fig:command}{{6}{25}{\textbf {Command copy versus filtered plant state.} Left, failure rate for graded efference copy at gain 1.0 for the filtered plant state, the pre-plant-filter command copy, and the current-visual oracle. Right, gate duty cycle for the same three signals; failure rates for the three gates were identical. The command copy overlaps the filtered plant state. Only the current-visual oracle differs}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Goal feedforward and its mechanism controls.} \textbf  {a}, failure rate for gate filtered and gate goal across feedforward gains at a 6~s window. \textbf  {b}, the same for graded cancellation. \textbf  {c}, self-state ablation at 100 and 200~ms: gate goal at $f_{\mathrm  {gain}} = 1.0$ with current proprioception, with delayed self-state, and plain gate filtered. \textbf  {d}, delaying the goal itself by 0 to 200~ms does not change failure; the visual delay does.}}{26}{figure.7}\protected@file@percent }
\newlabel{fig:feedforward}{{7}{26}{\textbf {Goal feedforward and its mechanism controls.} \textbf {a}, failure rate for gate filtered and gate goal across feedforward gains at a 6~s window. \textbf {b}, the same for graded cancellation. \textbf {c}, self-state ablation at 100 and 200~ms: gate goal at $f_{\mathrm {gain}} = 1.0$ with current proprioception, with delayed self-state, and plain gate filtered. \textbf {d}, delaying the goal itself by 0 to 200~ms does not change failure; the visual delay does}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Mechanism summary.} \textbf  {a}, a command copy computed from the issued command adds no information beyond the delayed visual estimate and does not rescue. \textbf  {b}, a goal feedforward torque computed from the instructed goal and current proprioception feeds the bar pathway and fully rescues through 200~ms and beyond. \textbf  {c}, replacing current self-state with delayed values in that branch removes the rescue.}}{26}{figure.8}\protected@file@percent }
\newlabel{fig:mechanism}{{8}{26}{\textbf {Mechanism summary.} \textbf {a}, a command copy computed from the issued command adds no information beyond the delayed visual estimate and does not rescue. \textbf {b}, a goal feedforward torque computed from the instructed goal and current proprioception feeds the bar pathway and fully rescues through 200~ms and beyond. \textbf {c}, replacing current self-state with delayed values in that branch removes the rescue}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Delay limits.} \textbf  {a}, failure rate on a 10~ms grid from 0 to 250~ms at a 6~s window ($n = 8$ per cell). Gate filtered first crosses 50\% failure at 130~ms; gate goal at $f_{\mathrm  {gain}} = 1.0$ never does. \textbf  {b}, long delays at a 10~s window ($n = 8$ per cell). Gate goal at 1.0 stays at 0\% through 500~ms; gate goal at 0.5 degrades beyond 200~ms.}}{27}{figure.9}\protected@file@percent }
\newlabel{fig:limits}{{9}{27}{\textbf {Delay limits.} \textbf {a}, failure rate on a 10~ms grid from 0 to 250~ms at a 6~s window ($n = 8$ per cell). Gate filtered first crosses 50\% failure at 130~ms; gate goal at $f_{\mathrm {gain}} = 1.0$ never does. \textbf {b}, long delays at a 10~s window ($n = 8$ per cell). Gate goal at 1.0 stays at 0\% through 500~ms; gate goal at 0.5 degrades beyond 200~ms}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Noise robustness.} Failure rate at 100~ms (\textbf  {a}) and 200~ms (\textbf  {b}) as the torque-noise standard deviation rises from 0 to $10^{-11}$~N~m ($n = 8$ per cell). Gate goal at 0.5 and 1.0 stays at 0\% at every noise level.}}{27}{figure.10}\protected@file@percent }
\newlabel{fig:noise}{{10}{27}{\textbf {Noise robustness.} Failure rate at 100~ms (\textbf {a}) and 200~ms (\textbf {b}) as the torque-noise standard deviation rises from 0 to $10^{-11}$~N~m ($n = 8$ per cell). Gate goal at 0.5 and 1.0 stays at 0\% at every noise level}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Example trajectories at 200~ms, 10~s window.} \textbf  {a}, heading for four variants with the bar target (dashed). Addition and graded filtered leave $\pm 2\pi $ (off scale); both gates stay bounded. \textbf  {b}, grating-gate state for the two gating variants; the filtered gate is closed in 86\% of samples, the goal gate in 25\%. Single parameter set and seed; illustrative, not statistical.}}{27}{figure.11}\protected@file@percent }
\newlabel{fig:traj}{{11}{27}{\textbf {Example trajectories at 200~ms, 10~s window.} \textbf {a}, heading for four variants with the bar target (dashed). Addition and graded filtered leave $\pm 2\pi $ (off scale); both gates stay bounded. \textbf {b}, grating-gate state for the two gating variants; the filtered gate is closed in 86\% of samples, the goal gate in 25\%. Single parameter set and seed; illustrative, not statistical}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Failure-free curves at 140~ms.} Fraction of runs without a failure over time, pooled over three seeds and eight parameter sets ($n = 24$ per curve) from the multi-seed check. Graded variants fail within the first second; gate goal never fails.}}{28}{figure.12}\protected@file@percent }
\newlabel{fig:survival}{{12}{28}{\textbf {Failure-free curves at 140~ms.} Fraction of runs without a failure over time, pooled over three seeds and eight parameter sets ($n = 24$ per curve) from the multi-seed check. Graded variants fail within the first second; gate goal never fails}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Body-parameter phase diagram.} Failure rate averaged over drags and grating gains for gate filtered (\textbf  {a}) and gate goal at $f_{\mathrm  {gain}} = 1.0$ (\textbf  {b}), across four inertias and eight delays (12 body-gain combinations per cell). Gate goal fails in no combination at any delay; gate filtered degrades with body time constant and delay.}}{28}{figure.13}\protected@file@percent }
\newlabel{fig:phase}{{13}{28}{\textbf {Body-parameter phase diagram.} Failure rate averaged over drags and grating gains for gate filtered (\textbf {a}) and gate goal at $f_{\mathrm {gain}} = 1.0$ (\textbf {b}), across four inertias and eight delays (12 body-gain combinations per cell). Gate goal fails in no combination at any delay; gate filtered degrades with body time constant and delay}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Freshness, timing, and content of the self-state signal.} \textbf  {a}, failure rate as the self-state sample ages, at visual delays of 100~ms (solid) and 200~ms (dashed); gate goal degrades between 20 and 40~ms of sample age, graded goal by 10 to 20~ms; horizontal lines mark gate filtered. \textbf  {b}, failure rate at 200~ms versus goal onset (bar onset fixed at 0.5~s, vertical line); no dependence for any variant. \textbf  {c}, failure rate at 200~ms for the no-goal damping control across three gains (purple, gate; green, graded), with the goal-tracking gate and gate filtered as references; damping without any goal content rescues the gate. $n = 8$ per cell.}}{29}{figure.14}\protected@file@percent }
\newlabel{fig:selfstate}{{14}{29}{\textbf {Freshness, timing, and content of the self-state signal.} \textbf {a}, failure rate as the self-state sample ages, at visual delays of 100~ms (solid) and 200~ms (dashed); gate goal degrades between 20 and 40~ms of sample age, graded goal by 10 to 20~ms; horizontal lines mark gate filtered. \textbf {b}, failure rate at 200~ms versus goal onset (bar onset fixed at 0.5~s, vertical line); no dependence for any variant. \textbf {c}, failure rate at 200~ms for the no-goal damping control across three gains (purple, gate; green, graded), with the goal-tracking gate and gate filtered as references; damping without any goal content rescues the gate. $n = 8$ per cell}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Fair comparators, ablations, and empirical constraints.} Six panels; model panels use eight body-gain parameter sets at a 6~s window, noise levels 0 and $10^{-13}$ identical and shown once. \textbf  {a}, failure rate versus visual feedback delay. Delayed-only estimation fails at every order tested: the Taylor feedforward fails from 50~ms and the naive forward-model observer from 50--100~ms, and the delay-embedding observer \texttt  {smith\_dde} (brown) fails in 8 of 8 sets at all delays including 50~ms. Instantaneous classical PD without gating (green) fails 38--62\%, but instantaneous PD with grating gating (\texttt  {pd\_gate}, pink) is at 0\% at every delay, as is the gated goal-branch reference (purple); delayed filtered baselines fail throughout (orange). \textbf  {b}, ablations within the rescue architecture (left): the gate-goal reference and its $|F_{\mathrm  {bar}}|$-only trigger both fail in none of the sets at any delay, while disabling the gate raises failure to 0.88--1.00. Delay-assignment robustness (right): granting current heading and angular velocity to the delayed pathways (addition, graded filtered, and gate filtered, all undelayed) leaves every variant at 0\% failure; the delayed reference fails throughout. Bars: mean failure over delays and eight parameter sets. \textbf  {c}, fly-level benchmark reproduction of the counter-evidence dataset: per-epoch correlation between population traces reconstructed from per-fly data and the authors' precomputed traces, for Mi4, T4/T5 experimental epochs, and five LPTC cell types. Mi4 reproduces exactly ($r=1.0$); dotted line $r=0.9$. \textbf  {d}, graded-versus-gated model selection at $n=19$ flies: per-held-out-fly difference in cross-validated RMSE (gated minus graded; negative favors gated) with the preregistered median (left) and the per-fly distribution against the minimum detectable effect (orange). The preregistered resolution rule marks this round inconclusive ($p=0.534$). \textbf  {e}, motor history versus HS membrane potential: per-animal held-out difference in explained variance (motor-history model minus visual-history model) in leave-one-animal-out validation across 12 animals (lags $\ge $ 20~ms; capacity-matched; whole-animal splits). Median $+0.056$; 9/12 animals positive; exact sign-flip $p=0.0503$; bootstrap 95\% CI of the median crosses zero. Claim ceiling: additional predictive information only. \textbf  {f}, state-dependent perturbation tests in two preregistered rounds: median held-out log-likelihood gains for the main effect and frozen negative controls. Round 1 (left): the naive endpoint's main effect ($+28.1$) is matched by pseudo-pulses in unstimulated controls ($+20.1$). Round 2 (right): a residual pipeline that removes the state-to-behavior map learned from non-pulse epochs shrinks the control floor to $+6.9$ while a consistent excess remains (median $+8.6$; dots, 6/6 animals positive; $p=1/64$), below the preregistered three-fold specificity threshold.}}{30}{figure.15}\protected@file@percent }
\newlabel{fig:composite}{{15}{30}{\textbf {Fair comparators, ablations, and empirical constraints.} Six panels; model panels use eight body-gain parameter sets at a 6~s window, noise levels 0 and $10^{-13}$ identical and shown once. \textbf {a}, failure rate versus visual feedback delay. Delayed-only estimation fails at every order tested: the Taylor feedforward fails from 50~ms and the naive forward-model observer from 50--100~ms, and the delay-embedding observer \texttt {smith\_dde} (brown) fails in 8 of 8 sets at all delays including 50~ms. Instantaneous classical PD without gating (green) fails 38--62\%, but instantaneous PD with grating gating (\texttt {pd\_gate}, pink) is at 0\% at every delay, as is the gated goal-branch reference (purple); delayed filtered baselines fail throughout (orange). \textbf {b}, ablations within the rescue architecture (left): the gate-goal reference and its $|F_{\mathrm {bar}}|$-only trigger both fail in none of the sets at any delay, while disabling the gate raises failure to 0.88--1.00. Delay-assignment robustness (right): granting current heading and angular velocity to the delayed pathways (addition, graded filtered, and gate filtered, all undelayed) leaves every variant at 0\% failure; the delayed reference fails throughout. Bars: mean failure over delays and eight parameter sets. \textbf {c}, fly-level benchmark reproduction of the counter-evidence dataset: per-epoch correlation between population traces reconstructed from per-fly data and the authors' precomputed traces, for Mi4, T4/T5 experimental epochs, and five LPTC cell types. Mi4 reproduces exactly ($r=1.0$); dotted line $r=0.9$. \textbf {d}, graded-versus-gated model selection at $n=19$ flies: per-held-out-fly difference in cross-validated RMSE (gated minus graded; negative favors gated) with the preregistered median (left) and the per-fly distribution against the minimum detectable effect (orange). The preregistered resolution rule marks this round inconclusive ($p=0.534$). \textbf {e}, motor history versus HS membrane potential: per-animal held-out difference in explained variance (motor-history model minus visual-history model) in leave-one-animal-out validation across 12 animals (lags $\ge $ 20~ms; capacity-matched; whole-animal splits). Median $+0.056$; 9/12 animals positive; exact sign-flip $p=0.0503$; bootstrap 95\% CI of the median crosses zero. Claim ceiling: additional predictive information only. \textbf {f}, state-dependent perturbation tests in two preregistered rounds: median held-out log-likelihood gains for the main effect and frozen negative controls. Round 1 (left): the naive endpoint's main effect ($+28.1$) is matched by pseudo-pulses in unstimulated controls ($+20.1$). Round 2 (right): a residual pipeline that removes the state-to-behavior map learned from non-pulse epochs shrinks the control floor to $+6.9$ while a consistent excess remains (median $+8.6$; dots, 6/6 animals positive; $p=1/64$), below the preregistered three-fold specificity threshold}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {The freshness hierarchy transfers to artificial delayed-control tasks.} Failure rate versus observation delay (0--600~ms) for six controller families across three randomized task families (T1 cart-pole, T2 rotary pendulum, T3 reference tracking; 30 plants each; process noise; failure includes a fixed mid-episode state impulse). Fresh-state LQR with delayed reference (F) is stable at every delay in all tasks; delayed-observation LQR (C) and velocity extrapolation (E1) cross 50\% failure at 50--200~ms; the delay-embedding observer (E2/E2m) reaches 150--300~ms; stacking the delayed-state term ungated (F+) degrades the fresh family to 150--400~ms. Preregistration SHA-256 6e56c187.}}{31}{figure.16}\protected@file@percent }
\newlabel{fig:transfer}{{16}{31}{\textbf {The freshness hierarchy transfers to artificial delayed-control tasks.} Failure rate versus observation delay (0--600~ms) for six controller families across three randomized task families (T1 cart-pole, T2 rotary pendulum, T3 reference tracking; 30 plants each; process noise; failure includes a fixed mid-episode state impulse). Fresh-state LQR with delayed reference (F) is stable at every delay in all tasks; delayed-observation LQR (C) and velocity extrapolation (E1) cross 50\% failure at 50--200~ms; the delay-embedding observer (E2/E2m) reaches 150--300~ms; stacking the delayed-state term ungated (F+) degrades the fresh family to 150--400~ms. Preregistration SHA-256 6e56c187}{figure.16}{}}
