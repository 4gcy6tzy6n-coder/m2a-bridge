\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Model and delay manipulation.} Schematic of the bar and grating pathways, the body, and the five variants. The delay is applied to the visually sensed state; the body and torque filters are current. Filtered and unfiltered refer to the bar-pathway signal used by the efference copy or gate, not to a sensory-versus-motor distinction.}}{23}{figure.1}\protected@file@percent }
\newlabel{fig:model}{{1}{23}{\textbf {Model and delay manipulation.} Schematic of the bar and grating pathways, the body, and the five variants. The delay is applied to the visually sensed state; the body and torque filters are current. Filtered and unfiltered refer to the bar-pathway signal used by the efference copy or gate, not to a sensory-versus-motor distinction}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Efference-copy gain by delay.} Failure rate for graded filtered, gate filtered, and gate unfiltered across efference-copy gains (0, 0.05, 0.25, 0.5, 0.75, 1.0) and delays (0.02, 0.05, 0.10, 0.20~s). At gain 0 or 0.05, graded filtered is indistinguishable from no efference copy. At gains of 0.25 or more, it is worse at 50~ms. Gating is gain-invariant by construction.}}{23}{figure.2}\protected@file@percent }
\newlabel{fig:gain}{{2}{23}{\textbf {Efference-copy gain by delay.} Failure rate for graded filtered, gate filtered, and gate unfiltered across efference-copy gains (0, 0.05, 0.25, 0.5, 0.75, 1.0) and delays (0.02, 0.05, 0.10, 0.20~s). At gain 0 or 0.05, graded filtered is indistinguishable from no efference copy. At gains of 0.25 or more, it is worse at 50~ms. Gating is gain-invariant by construction}{figure.2}{}}
